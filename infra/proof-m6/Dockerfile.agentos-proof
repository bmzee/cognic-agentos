ARG BASE_IMAGE=cognic-agentos:proof1b2-base
FROM ${BASE_IMAGE}
USER root
# trust staging (same shape as proof-m5, now THREE released packs): wheel installs +
# per-pack attestations + trust roots + alembic.ini. stage-packs.sh downloads +
# sha256-verifies the released assets and arranges proof-m6-staging/ before build.
#   * cognic-tool-oracle-schema@v0.2.0 (cognic.tools) — operator-installed via the
#     M4 lifecycle flow by the runner; the M6 skill's declared tools resolve to it.
#   * cognic-hook-schema-guard@v0.1.0 (cognic.hooks) — baked into the kernel venv;
#     REQUIRED because the oracle v0.2.0 manifest binds its dlp_pre hooks (an
#     absent hook pack would fail-close every governed tool call at the DLP gate).
#   * cognic-skill-schema-summary@v0.1.0 (cognic.skills) — baked into the kernel
#     venv so boot trust-registration + SKILL.md hosting/ingestion (ADR-025) see
#     it; the ACTION never executes here — only in the skill-runtime sandbox
#     image. NEVER operator-installed (trust-register + registry-admit only).
# The staged attestations + trust roots are what the approve 5-gate's SIGNATURE
# gate cosign-verifies (oracle, via /opt/cognic/trust-roots/_default) and what the
# hook + skill packs' boot trust registrations verify (per-pack keys under the
# same prefix — the three releases are signed with THREE DIFFERENT cosign keys:
# hook-packs/<id>/cosign.pub + skill-packs/<id>/cosign.pub).
COPY proof-m6-staging/wheel/ /tmp/wheel/
RUN /opt/venv/bin/python -m ensurepip --upgrade \
 && /opt/venv/bin/python -m pip install --no-deps --no-cache-dir /tmp/wheel/*.whl && rm -rf /tmp/wheel
# M6: aiodocker — is_sandbox_available() (harness/sandbox.py) requires it for the
# DockerSibling managed sandbox runtime; it lives in the sandbox-docker extra,
# NOT the adapters extra the base was built with. Installed WITH deps (aiohttp).
# Floor mirrors pyproject [project.optional-dependencies].sandbox-docker.
RUN /opt/venv/bin/python -m pip install --no-cache-dir "aiodocker>=0.24"
# syft — the sandbox admission SBOM gate (sandbox/catalog.py
# verify_sbom_policy_or_refuse) shells out to `syft` at RUNTIME to inspect the
# canonical images. **PRODUCT FINDING (run 11, 2026-07-04):** the
# default-adapters BASE image ships cosign + opa but NOT syft, so a deployed
# kernel with the sandbox backend enabled hits "failed to launch syft:
# FileNotFoundError" at the sidecar admission. The proof installs it here
# (pinned v1.44.0 linux_amd64 — matching the amd64 base + the host preflight
# syft), mirroring the base's cosign install; the real fix is to add syft to
# the base image when sandbox is deployable (flagged follow-up, NOT changed
# mid-proof). amd64 to match the base's cosign-linux-amd64 / opa amd64 pins.
# Fetch via busybox wget (run 12, 2026-07-04): curl exists ONLY in the base's
# BUILDER stage (cosign + opa are downloaded there and COPY'd in); this
# runtime stage is bare alpine+busybox. Bounded retry loop for transient
# network failures; a download that never lands fails CLOSED at the sha256
# gate (missing/partial file -> digest mismatch -> build error).
RUN for attempt in 1 2 3 4 5; do \
      wget -q -O /tmp/syft.tar.gz \
        "https://github.com/anchore/syft/releases/download/v1.44.0/syft_1.44.0_linux_amd64.tar.gz" \
      && break; \
      echo "syft download failed (attempt ${attempt}/5); retrying in 3s" >&2; \
      sleep 3; \
    done \
 && echo "0e91737aee2b5baf1d255b959630194a302335d848ff97bb07921eb6205b5f5a  /tmp/syft.tar.gz" | sha256sum -c - \
 && tar -xzf /tmp/syft.tar.gz -C /tmp syft \
 && install -m 0755 /tmp/syft /usr/local/bin/syft \
 && rm -f /tmp/syft.tar.gz /tmp/syft \
 && /usr/local/bin/syft version >/dev/null
COPY proof-m6-staging/pack-attestations/ /opt/cognic/pack-attestations/
COPY proof-m6-staging/trust-roots/ /opt/cognic/trust-roots/
COPY proof-m6-staging/policies/ /opt/cognic/policies/
COPY proof-m6-staging/alembic.ini /app/alembic.ini
# M6: the proof CANONICAL-IMAGE trust material (generated by the runner AFTER
# stage-packs and BEFORE this build): cosign.pub = the proof canonical cosign
# PUBLIC key both re-homed sandbox images (skill-runtime + egress-proxy) are
# signed under; registry-ca.pem = the local TLS registry's CA. The sandbox
# admission gate (sandbox/catalog.py) cosign-verifies the runtime image against
# COGNIC_SANDBOX_CANONICAL_IMAGE_TRUST_ROOT_PATH — REAL verification, no
# fixture flag. SSL_CERT_FILE must be a BUNDLE (system CAs + the registry CA)
# so cosign trusts the proof registry while public TLS keeps verifying.
COPY proof-m6-staging/canonical-trust/ /opt/cognic/canonical-trust/
# The registry CA must ALSO live in the SYSTEM trust store: the sandbox
# admission gate's cosign runs as a subprocess with a FROZEN 2-key env
# (sandbox/catalog.py `_SUBPROCESS_ENV` = PATH+HOME only, the trust-gate
# doctrine), so the pod's SSL_CERT_FILE never reaches it and Go falls back to
# /etc/ssl/certs/ca-certificates.crt — hit live 2026-07-04 ("certificate
# signed by unknown authority" at in-pod verify). The env-var bundle is kept
# for ordinary env-reading consumers.
RUN cat /opt/cognic/canonical-trust/registry-ca.pem >> /etc/ssl/certs/ca-certificates.crt \
 && cat /etc/ssl/certs/ca-certificates.crt > /opt/cognic/canonical-trust/ca-bundle.pem
# Proof-only current-source overlay: cached base images may carry an older
# cognic_agentos package, while the live proof must exercise THIS branch's M6
# wiring (SkillExecutor + SkillBroker + skill hosting + the skills route). The
# runner copies src/cognic_agentos into this context. The SAME overlay lands in
# Dockerfile.skill-runtime so the broker + in-sandbox runner share one wire
# protocol byte-for-byte.
RUN rm -rf /opt/venv/lib/python3.12/site-packages/cognic_agentos
COPY cognic_agentos/ /opt/venv/lib/python3.12/site-packages/cognic_agentos/
# proof-only MULTI-ACTOR app factory (vendored into the image so uvicorn can import it)
COPY proof_m6/ /app/proof_m6/
RUN chmod -R a+rX /opt/cognic /app/alembic.ini /app/proof_m6 /opt/venv/lib/python3.12/site-packages/cognic_agentos
ENV COGNIC_PACK_ATTESTATION_ROOT_PATH=/opt/cognic/pack-attestations \
    COGNIC_SIGNATURE_ROOT_PATH=/opt/cognic/pack-attestations \
    COGNIC_TRUST_ROOT_PREFIX=/opt/cognic/trust-roots \
    COGNIC_PLUGIN_ALLOWLIST_PATH=/opt/cognic/policies/plugin_allowlist.json \
    COGNIC_SANDBOX_CANONICAL_IMAGE_TRUST_ROOT_PATH=/opt/cognic/canonical-trust/cosign.pub \
    SSL_CERT_FILE=/opt/cognic/canonical-trust/ca-bundle.pem
# /app/proof_m6 is vendored (COPY, not pip-installed), so /app must be importable.
# The default-adapters base sets no PYTHONPATH and runs uvicorn as a console script
# (sys.path[0] = /opt/venv/bin, NOT the /app WORKDIR), so make /app explicit rather
# than relying on uvicorn's --app-dir cwd default.
ENV PYTHONPATH=/app
USER cognic
# override the default CMD to the PROOF multi-actor app factory (the only kernel-facing
# change, and it is image-level).
CMD ["sh","-c","exec uvicorn proof_m6.proof_app:create_proof_app --factory --host 0.0.0.0 --port 8000"]
