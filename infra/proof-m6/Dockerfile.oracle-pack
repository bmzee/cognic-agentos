# infra/proof-m6/Dockerfile.oracle-pack — the released oracle-schema MCP tool
# Service, M6: the SAME v0.2.0 release M5 proved (DLP-governed; the delta over
# v0.1.0 was manifest-only — [data_governance].dlp_pre_hooks binds the two
# schema-guard hooks, which the KERNEL enforces pre-invocation). The M6 skill's
# declared tools (list_tables + describe_table) resolve to THIS deployed server
# through the broker -> MCPHost.call_tool governed path.
# Built from the DOWNLOADED v0.2.0 release wheel (released assets only) staged at
# proof-m6-staging/wheel/ by stage-packs.sh (sha256-pinned), with the pack's full
# runtime deps. Context = infra/proof-m6/.
FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir \
      "mcp==1.27.0" "uvicorn[standard]>=0.35" "oracledb>=2.5" "PyJWT[crypto]>=2.10,<3"
COPY proof-m6-staging/wheel/cognic_tool_oracle_schema-0.2.0-py3-none-any.whl /tmp/
RUN pip install --no-cache-dir --no-deps /tmp/cognic_tool_oracle_schema-0.2.0-py3-none-any.whl
CMD ["python", "-m", "cognic_tool_oracle_schema.server"]
