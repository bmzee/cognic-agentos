ARG BASE_IMAGE=cognic-agentos:proof1b2-base
FROM ${BASE_IMAGE}
# Kernel anchor — the M8 branch commit this proof deploys. The runner builds
# the base + overlays THIS branch's source; the anchor label pins exactly
# which kernel the evidence was produced against.
#   feat/m8-governed-agent-loop @ b910108ab705f9b6b8359ba61b5214d3ae8c5e66
ARG KERNEL_ANCHOR=b910108ab705f9b6b8359ba61b5214d3ae8c5e66
LABEL io.cognic.proof.kernel-anchor=$KERNEL_ANCHOR \
      io.cognic.proof.milestone="m8-governed-agent-loop"
USER root
# trust staging (same shape as proof-m6, now SEVEN released packs): wheel
# installs + per-pack attestations + trust roots + alembic.ini. stage-packs.sh
# downloads + sha256-verifies the released assets and arranges
# proof-m8-staging/ before build.
#   * cognic-tool-oracle-schema@v0.3.0 (cognic.tools) — operator-installed via
#     the M4 lifecycle flow by the runner; the agent's granted
#     run_readonly_query resolves to it.
#   * cognic-hook-schema-guard@v0.1.0 (cognic.hooks) — baked into the kernel
#     venv; REQUIRED because the oracle v0.3.0 manifest binds its dlp_pre
#     hooks (an absent hook pack would fail-close every governed tool call at
#     the DLP gate).
#   * the FOUR instruction skill packs (customer-data / financial-data /
#     cards-data / atm-recon) — content packs, NO entry point; discovered by
#     the B2-pre manifest-walk arm, cosign-verified against their per-pack
#     skill-packs/ roots, hosted + ingested (SKILL.md), NEVER executed.
#   * cognic-agent-bank-analyst@v0.1.0 (cognic.agents inert marker) — the
#     declarative agent pack; trust-registered against its per-pack DUAL root
#     (cosign.pub + agent-card.pub).
COPY proof-m8-staging/wheel/ /tmp/wheel/
RUN /opt/venv/bin/python -m ensurepip --upgrade \
 && /opt/venv/bin/python -m pip install --no-deps --no-cache-dir /tmp/wheel/*.whl && rm -rf /tmp/wheel
# aiodocker — is_sandbox_available() (harness/sandbox.py) requires it for the
# DockerSibling managed sandbox runtime; it lives in the sandbox-docker extra,
# NOT the adapters extra the base was built with. Installed WITH deps
# (aiohttp). Floor mirrors pyproject [project.optional-dependencies].
# M8 note: no skill EXECUTES in this proof (all four staged skills are
# instruction-mode), but the M6 executable-skill posture stays deployed
# unchanged — hosted_skills + the skill executor construct only when the
# sandbox runtime is real, and step 0 asserts that surface.
RUN /opt/venv/bin/python -m pip install --no-cache-dir "aiodocker>=0.24"
# syft — the sandbox admission SBOM gate (sandbox/catalog.py) shells out to
# `syft` at RUNTIME; the default-adapters BASE ships cosign + opa but NOT syft
# (the M6 run-11 product finding; base follow-up flagged, NOT changed
# mid-proof). Pinned amd64 tarball, sha256 fail-closed, fetched with busybox
# wget (the runtime stage is bare alpine+busybox — curl exists only in the
# base's BUILDER stage; the M6 run-12 finding).
RUN for attempt in 1 2 3 4 5; do \
      wget -q -O /tmp/syft.tar.gz \
        "https://github.com/anchore/syft/releases/download/v1.44.0/syft_1.44.0_linux_amd64.tar.gz" \
      && break; \
      echo "syft download failed (attempt ${attempt}/5); retrying in 3s" >&2; \
      sleep 3; \
    done \
 && echo "0e91737aee2b5baf1d255b959630194a302335d848ff97bb07921eb6205b5f5a  /tmp/syft.tar.gz" | sha256sum -c - \
 && tar -xzf /tmp/syft.tar.gz -C /tmp syft \
 && install -m 0755 /tmp/syft /usr/local/bin/syft \
 && rm -f /tmp/syft.tar.gz /tmp/syft \
 && /usr/local/bin/syft version >/dev/null
COPY proof-m8-staging/pack-attestations/ /opt/cognic/pack-attestations/
COPY proof-m8-staging/trust-roots/ /opt/cognic/trust-roots/
COPY proof-m8-staging/agent-cards/ /opt/cognic/agent-cards/
COPY proof-m8-staging/policies/ /opt/cognic/policies/
COPY proof-m8-staging/alembic.ini /app/alembic.ini
# The proof CANONICAL-IMAGE trust material (generated by the runner AFTER
# stage-packs and BEFORE this build): cosign.pub = the proof canonical cosign
# PUBLIC key the re-homed sandbox images are signed under; registry-ca.pem =
# the local TLS registry's CA. The sandbox admission gate cosign-verifies
# against COGNIC_SANDBOX_CANONICAL_IMAGE_TRUST_ROOT_PATH — REAL verification,
# no fixture flag. SSL_CERT_FILE must be a BUNDLE (system CAs + the registry
# CA) so cosign trusts the proof registry while public TLS keeps verifying;
# the registry CA must ALSO live in the SYSTEM store because the admission
# cosign subprocess runs with a FROZEN 2-key env (the M6 live findings).
COPY proof-m8-staging/canonical-trust/ /opt/cognic/canonical-trust/
RUN cat /opt/cognic/canonical-trust/registry-ca.pem >> /etc/ssl/certs/ca-certificates.crt \
 && cat /etc/ssl/certs/ca-certificates.crt > /opt/cognic/canonical-trust/ca-bundle.pem
# M8 — query-context key custody (ADR-027 §c):
#   * the PUBLIC PEM is baked (verification surfaces + operator standalone
#     verification; the oracle-pack image bakes the same public key for its
#     token verifier). The runner generates the keypair AFTER stage-packs and
#     stages ONLY the public half into proof-m8-staging/query-context/.
#   * the PRIVATE PEM is NEVER COPY'd into ANY layer. The kernel reads it at
#     lifespan from COGNIC_AGENT_QUERY_CONTEXT_SIGNING_KEY_PATH, which points
#     at a RUNTIME mount (/run/cognic/query-context/ — a k8s Secret the
#     runner stages; secret-equivalent staging, proof-local only).
COPY proof-m8-staging/query-context/ /opt/cognic/query-context/
# Proof-only current-source overlay: cached base images may carry an older
# cognic_agentos package, while the live proof must exercise THIS branch's M8
# wiring (AgentLoop + AgentDispatcher + entitlement/assignment stores + the
# agents route). The runner copies src/cognic_agentos into this context.
RUN rm -rf /opt/venv/lib/python3.12/site-packages/cognic_agentos
COPY cognic_agentos/ /opt/venv/lib/python3.12/site-packages/cognic_agentos/
# Proof-only policy-bundle overlay (SAME rationale as the source overlay): the
# agents.rego dispatch bundle is NEW at M8 — a cached pre-M8 base would lack
# /app/policies/_default/agents.rego and every dispatch would fail-close
# opa_unavailable -> agent_policy_denied. The runner copies policies/ into
# this context alongside cognic_agentos/.
RUN rm -rf /app/policies
COPY policies/ /app/policies/
# proof-only MULTI-ACTOR app factory (vendored into the image so uvicorn can
# import it; lands with Task C2 — analyst.amir / analyst.sara actors carrying
# the agent.ask scope, mirroring proof_m6's X-Proof-Role binder).
COPY proof_m8/ /app/proof_m8/
RUN chmod -R a+rX /opt/cognic /app/alembic.ini /app/policies /app/proof_m8 /opt/venv/lib/python3.12/site-packages/cognic_agentos
ENV COGNIC_PACK_ATTESTATION_ROOT_PATH=/opt/cognic/pack-attestations \
    COGNIC_SIGNATURE_ROOT_PATH=/opt/cognic/pack-attestations \
    COGNIC_TRUST_ROOT_PREFIX=/opt/cognic/trust-roots \
    COGNIC_PLUGIN_ALLOWLIST_PATH=/opt/cognic/policies/plugin_allowlist.json \
    COGNIC_SANDBOX_CANONICAL_IMAGE_TRUST_ROOT_PATH=/opt/cognic/canonical-trust/cosign.pub \
    SSL_CERT_FILE=/opt/cognic/canonical-trust/ca-bundle.pem
# M8 agent-loop wiring (ADR-027):
#   * agents.rego — the A5 dispatch bundle (absolute path into the overlaid
#     /app/policies so a stale base can never shadow it);
#   * the query-context SIGNING key path — a RUNTIME MOUNT reference (see the
#     custody note above; NEVER a baked file);
#   * the AgentCard-JWS trust root — the DUAL-root agent-card.pub staged
#     per-pack next to the cosign key (finding-#4 custody split: the JWS is
#     never verified against cosign.pub);
#   * tier aliases — NON-dev aliases (deploy-safety guard G6 refuses dev
#     aliases once external LLM is enabled); the litellm model_list mapping
#     for both lives in proof-m8-values.yaml. The cloud-policy toggles
#     (COGNIC_ALLOW_EXTERNAL_LLM / COGNIC_POLICY_MODE /
#     COGNIC_ALLOWED_PROVIDERS) + the provider API key are runner-supplied at
#     deploy time (operator env; never image-baked).
ENV COGNIC_AGENTS_POLICY_BUNDLE=/app/policies/_default/agents.rego \
    COGNIC_AGENT_QUERY_CONTEXT_SIGNING_KEY_PATH=/run/cognic/query-context/query-context-private.pem \
    COGNIC_AGENT_CARD_JWS_TRUST_ROOT_PATH=/opt/cognic/trust-roots/agent-packs/cognic-agent-bank-analyst/agent-card.pub \
    COGNIC_TIER1_ALIAS=cognic-tier1-proof-m8 \
    COGNIC_TIER2_ALIAS=cognic-tier2-proof-m8
# /app/proof_m8 is vendored (COPY, not pip-installed), so /app must be
# importable (the default-adapters base sets no PYTHONPATH and runs uvicorn
# as a console script).
ENV PYTHONPATH=/app
USER cognic
# override the default CMD to the PROOF multi-actor app factory (the only
# kernel-facing change, and it is image-level).
CMD ["sh","-c","exec uvicorn proof_m8.proof_app:create_proof_app --factory --host 0.0.0.0 --port 8000"]
