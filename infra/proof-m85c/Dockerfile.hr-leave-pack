# infra/proof-m85c/Dockerfile.hr-leave-pack — the released M8.5-E governed
# write pack. The image is built only from the sha256-pinned v0.1.0 release
# wheel staged by stage-packs.sh. It verifies, but never mints, the kernel's
# per-run action-context token; only the public half enters this image.
FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir \
      "mcp==1.27.0" "uvicorn[standard]>=0.35" "oracledb>=2.5" \
      "PyJWT[crypto]>=2.10,<3" "joserfc==1.6.4" "cryptography>=45"
COPY proof-m85c-staging/wheel/cognic_tool_hr_leave-0.1.0-py3-none-any.whl /tmp/
RUN pip install --no-cache-dir --no-deps /tmp/cognic_tool_hr_leave-0.1.0-py3-none-any.whl
COPY proof-m85c-staging/action-context/action-context-public.pem /opt/cognic/action-context/action-context-public.pem
CMD ["python", "-m", "cognic_tool_hr_leave.server"]
